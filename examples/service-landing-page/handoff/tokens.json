{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "A specific, editorial landing page for an operations-mapping service aimed at small service-business owners.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.141,
          0.294,
          0.247
        ],
        "hex": "#244b3f"
      }
    },
    "on-primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          0.992,
          0.969
        ],
        "hex": "#fffdf7"
      }
    },
    "background": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.953,
          0.933,
          0.894
        ],
        "hex": "#f3eee4"
      }
    },
    "surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          0.992,
          0.969
        ],
        "hex": "#fffdf7"
      }
    },
    "border": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.812,
          0.78,
          0.722
        ],
        "hex": "#cfc7b8"
      }
    },
    "on-surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.145,
          0.137,
          0.118
        ],
        "hex": "#25231e"
      }
    },
    "on-surface-muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.424,
          0.4,
          0.357
        ],
        "hex": "#6c665b"
      }
    },
    "accent": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.886,
          0.329,
          0.176
        ],
        "hex": "#e2542d"
      }
    },
    "on-accent": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "hex": "#ffffff"
      }
    },
    "success": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.224,
          0.451,
          0.31
        ],
        "hex": "#39734f"
      }
    },
    "on-success": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "hex": "#ffffff"
      }
    },
    "error": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.678,
          0.231,
          0.196
        ],
        "hex": "#ad3b32"
      }
    },
    "focus": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.886,
          0.329,
          0.176
        ],
        "hex": "#e2542d"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 40,
        "unit": "px"
      }
    },
    "xxl": {
      "$value": {
        "value": 72,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 10,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 20,
        "unit": "px"
      }
    }
  },
  "typography": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "ui-serif, Georgia, serif",
        "fontSize": {
          "value": 72,
          "unit": "px"
        },
        "fontWeight": 600,
        "letterSpacing": {
          "value": -0.04,
          "unit": "em"
        }
      }
    },
    "headline": {
      "$type": "typography",
      "$value": {
        "fontFamily": "ui-sans-serif, system-ui, sans-serif",
        "fontSize": {
          "value": 32,
          "unit": "px"
        },
        "fontWeight": 700,
        "letterSpacing": {
          "value": -0.02,
          "unit": "em"
        }
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "ui-sans-serif, system-ui, sans-serif",
        "fontSize": {
          "value": 17,
          "unit": "px"
        },
        "fontWeight": 400,
        "letterSpacing": {
          "value": 0,
          "unit": "em"
        }
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "ui-monospace, monospace",
        "fontSize": {
          "value": 12,
          "unit": "px"
        },
        "fontWeight": 650,
        "letterSpacing": {
          "value": 0.06,
          "unit": "em"
        }
      }
    }
  }
}
