{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "A decision-first operations workspace for dispatchers coordinating repair jobs and blockers.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.071,
          0.243,
          0.29
        ],
        "hex": "#123e4a"
      }
    },
    "on-primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.965,
          0.984,
          0.988
        ],
        "hex": "#f6fbfc"
      }
    },
    "background": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.91,
          0.933,
          0.937
        ],
        "hex": "#e8eeef"
      }
    },
    "surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.973,
          0.984,
          0.984
        ],
        "hex": "#f8fbfb"
      }
    },
    "border": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.773,
          0.816,
          0.824
        ],
        "hex": "#c5d0d2"
      }
    },
    "on-surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.09,
          0.153,
          0.169
        ],
        "hex": "#17272b"
      }
    },
    "on-surface-muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.365,
          0.431,
          0.447
        ],
        "hex": "#5d6e72"
      }
    },
    "accent": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.867,
          0.42,
          0.239
        ],
        "hex": "#dd6b3d"
      }
    },
    "on-accent": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "hex": "#ffffff"
      }
    },
    "success": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.184,
          0.463,
          0.345
        ],
        "hex": "#2f7658"
      }
    },
    "on-success": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "hex": "#ffffff"
      }
    },
    "error": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.702,
          0.247,
          0.22
        ],
        "hex": "#b33f38"
      }
    },
    "focus": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.867,
          0.42,
          0.239
        ],
        "hex": "#dd6b3d"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 36,
        "unit": "px"
      }
    },
    "xxl": {
      "$value": {
        "value": 56,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 6,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 18,
        "unit": "px"
      }
    }
  },
  "typography": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "ui-sans-serif, system-ui, sans-serif",
        "fontSize": {
          "value": 48,
          "unit": "px"
        },
        "fontWeight": 750,
        "letterSpacing": {
          "value": -0.04,
          "unit": "em"
        }
      }
    },
    "headline": {
      "$type": "typography",
      "$value": {
        "fontFamily": "ui-sans-serif, system-ui, sans-serif",
        "fontSize": {
          "value": 28,
          "unit": "px"
        },
        "fontWeight": 720,
        "letterSpacing": {
          "value": -0.025,
          "unit": "em"
        }
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "ui-sans-serif, system-ui, sans-serif",
        "fontSize": {
          "value": 15,
          "unit": "px"
        },
        "fontWeight": 400,
        "letterSpacing": {
          "value": 0,
          "unit": "em"
        }
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "ui-monospace, monospace",
        "fontSize": {
          "value": 12,
          "unit": "px"
        },
        "fontWeight": 650,
        "letterSpacing": {
          "value": 0.04,
          "unit": "em"
        }
      }
    }
  }
}
