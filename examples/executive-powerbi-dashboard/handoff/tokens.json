{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "A weekly executive Power BI dashboard organized around one margin-recovery decision.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.153,
          0.247,
          0.196
        ],
        "hex": "#273f32"
      }
    },
    "on-primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "hex": "#ffffff"
      }
    },
    "background": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.945,
          0.933,
          0.898
        ],
        "hex": "#f1eee5"
      }
    },
    "surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          0.992,
          0.973
        ],
        "hex": "#fffdf8"
      }
    },
    "border": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.827,
          0.804,
          0.749
        ],
        "hex": "#d3cdbf"
      }
    },
    "on-surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.137,
          0.153,
          0.125
        ],
        "hex": "#232720"
      }
    },
    "on-surface-muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.408,
          0.439,
          0.4
        ],
        "hex": "#687066"
      }
    },
    "accent": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.835,
          0.404,
          0.247
        ],
        "hex": "#d5673f"
      }
    },
    "on-accent": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "hex": "#ffffff"
      }
    },
    "success": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.255,
          0.455,
          0.322
        ],
        "hex": "#417452"
      }
    },
    "on-success": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "hex": "#ffffff"
      }
    },
    "error": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.667,
          0.247,
          0.212
        ],
        "hex": "#aa3f36"
      }
    },
    "focus": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.835,
          0.404,
          0.247
        ],
        "hex": "#d5673f"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 36,
        "unit": "px"
      }
    },
    "xxl": {
      "$value": {
        "value": 52,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    }
  },
  "typography": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "ui-sans-serif, system-ui, sans-serif",
        "fontSize": {
          "value": 44,
          "unit": "px"
        },
        "fontWeight": 760,
        "letterSpacing": {
          "value": -0.04,
          "unit": "em"
        }
      }
    },
    "headline": {
      "$type": "typography",
      "$value": {
        "fontFamily": "ui-sans-serif, system-ui, sans-serif",
        "fontSize": {
          "value": 24,
          "unit": "px"
        },
        "fontWeight": 720,
        "letterSpacing": {
          "value": -0.02,
          "unit": "em"
        }
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "ui-sans-serif, system-ui, sans-serif",
        "fontSize": {
          "value": 14,
          "unit": "px"
        },
        "fontWeight": 400,
        "letterSpacing": {
          "value": 0,
          "unit": "em"
        }
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "ui-monospace, monospace",
        "fontSize": {
          "value": 11,
          "unit": "px"
        },
        "fontWeight": 650,
        "letterSpacing": {
          "value": 0.05,
          "unit": "em"
        }
      }
    }
  }
}
